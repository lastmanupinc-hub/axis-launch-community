<!doctype html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{ subject }}</title>
<!--[if mso]><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml><![endif]-->
<style>
  /* Client resets */
  body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
  table,td{mso-table-lspace:0;mso-table-rspace:0}
  img{-ms-interpolation-mode:bicubic;border:0;outline:none;text-decoration:none;display:block}
  body{margin:0;padding:0;width:100%!important;background:{{ palette.paper }}}
  a{color:{{ palette.blue }}}
  .wrap{width:100%;background:{{ palette.paper }}}
  .shell{width:600px;max-width:600px}
  @media screen and (max-width:620px){
    .shell{width:100%!important}
    .px{padding-left:22px!important;padding-right:22px!important}
    .h1{font-size:26px!important;line-height:32px!important}
    .stack{display:block!important;width:100%!important}
  }
  @media (prefers-color-scheme:dark){
    .wrap,.shell,.card{background:{{ palette.ink }}!important}
    .t,.h1,.h2{color:#F4F4F5!important}
    .meta{color:#9A9AA4!important}
    .rule{border-color:#2A2A30!important}
    a{color:{{ palette.blue_bright }}!important}
  }
</style>
</head>
<body>
<div style="display:none;font-size:1px;color:{{ palette.paper }};line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden">{{ preheader }}&#8199;&#65279;&#847;{{ '&#847;&zwnj;&nbsp;' * 60 }}</div>

<table role="presentation" class="wrap" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ palette.paper }}">
<tr><td align="center" style="padding:0">

<table role="presentation" class="shell" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px">

  <!-- signature rule -->
  <tr><td style="height:4px;line-height:4px;font-size:0;background:{{ palette.orange }}">&nbsp;</td></tr>

  <!-- masthead -->
  <tr><td class="px" style="background:{{ palette.ink }};padding:26px 32px">
    <a href="{{ brand.site }}" style="text-decoration:none">
      <img src="{{ asset_base }}/email-header@2x.png" width="300" height="70" alt="{{ brand.name }}" style="width:300px;height:70px">
    </a>
  </td></tr>

  <!-- issue line -->
  <tr><td class="px" style="padding:22px 32px 0">
    <p class="meta" style="margin:0;font:400 13px/18px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.slate }};letter-spacing:.3px">
      {{ issue.date_long }} &nbsp;&middot;&nbsp; {{ issue.slot_label }}{% if issue.number %} &nbsp;&middot;&nbsp; No. {{ issue.number }}{% endif %}
    </p>
  </td></tr>

  <!-- lede -->
  <tr><td class="px" style="padding:10px 32px 0">
    <h1 class="h1 t" style="margin:0;font:700 30px/36px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.graphite }};letter-spacing:-.4px">{{ issue.headline }}</h1>
    {% if issue.standfirst %}
    <p class="t" style="margin:14px 0 0;font:400 17px/26px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.graphite }}">{{ issue.standfirst }}</p>
    {% endif %}
    {% if lead_item %}
    <p style="margin:14px 0 0;font:700 15px/22px 'Liberation Sans',Arial,Helvetica,sans-serif">
      <a href="{{ lead_item.url }}" style="color:{{ palette.blue }};text-decoration:underline">Read the full piece</a>
    </p>
    {% endif %}
  </td></tr>

  {% for section in sections %}
  <tr><td class="px" style="padding:30px 32px 0">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td style="padding:0 0 6px">
        <span style="display:inline-block;height:3px;width:32px;background:{{ palette.orange }};font-size:0;line-height:3px">&nbsp;</span>
      </td></tr>
      <tr><td style="padding:0 0 4px">
        <h2 class="h2 t" style="margin:0;font:700 13px/18px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.graphite }};text-transform:uppercase;letter-spacing:1.4px">{{ section.title }}</h2>
      </td></tr>
      {% if section.blurb %}
      <tr><td style="padding:6px 0 0">
        <p class="meta" style="margin:0;font:400 14px/21px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.slate }}">{{ section.blurb }}</p>
      </td></tr>
      {% endif %}
    </table>
  </td></tr>

    {% for item in section.entries %}
    <tr><td class="px" style="padding:16px 32px 0">
      <table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr><td style="padding:0 0 4px">
          <a href="{{ item.url }}" class="t" style="font:700 18px/25px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.graphite }};text-decoration:none">{{ item.title }}</a>
        </td></tr>
        {% if item.summary %}
        <tr><td style="padding:2px 0 0">
          <p class="t" style="margin:0;font:400 15px/23px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.graphite }}">{{ item.summary }}</p>
        </td></tr>
        {% endif %}
        <tr><td style="padding:7px 0 0">
          {% set bits = [item.category, item.author, item.published] | select | list %}
          <p class="meta" style="margin:0;font:400 12px/17px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.slate }}">
            {%- for bit in bits %}{{ bit }} &middot; {% endfor -%}
            <a href="{{ item.url }}" style="color:{{ palette.blue }};text-decoration:underline">Read</a>
          </p>
        </td></tr>
      </table>
    </td></tr>
    {% endfor %}
  {% endfor %}

  {% if offer %}
  <!-- offer block: the number and its qualifier always travel together (compliance.md #2) -->
  <tr><td class="px" style="padding:32px 32px 0">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:{{ palette.ink }};border-radius:10px">
      <tr><td style="padding:26px 26px 24px">
        <p style="margin:0 0 8px;font:700 12px/16px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.orange }};text-transform:uppercase;letter-spacing:1.4px">This week</p>
        <p style="margin:0;font:700 23px/30px 'Liberation Sans',Arial,Helvetica,sans-serif;color:#FFFFFF">{{ offer.phrase }}</p>
        <p style="margin:10px 0 0;font:400 13px/20px 'Liberation Sans',Arial,Helvetica,sans-serif;color:#9A9AA4">
          {{ offer.exclusions_line }}{% if offer.ends_long %} Ends {{ offer.ends_long }}.{% endif %}{% if offer.stacking %} {{ offer.stacking }}.{% endif %}
        </p>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px">
          <tr><td align="center" style="background:{{ palette.orange }};border-radius:6px">
            <a href="{{ offer.url }}" style="display:inline-block;padding:13px 26px;font:700 15px/20px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.ink }};text-decoration:none">{{ offer.cta }}</a>
          </td></tr>
        </table>
      </td></tr>
    </table>
  </td></tr>
  {% endif %}

  {% if ps %}
  <tr><td class="px" style="padding:28px 32px 0">
    <p class="t" style="margin:0;font:400 15px/23px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.graphite }}"><strong>P.S.</strong> {{ ps }}</p>
  </td></tr>
  {% endif %}

  <!-- footer -->
  <tr><td class="px" style="padding:34px 32px 40px">
    <hr class="rule" style="border:0;border-top:1px solid {{ palette.rule }};margin:0 0 18px">
    <p class="meta" style="margin:0 0 10px;font:400 12px/19px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.slate }}">
      You are receiving this because you signed up at {{ brand.site_display }}{% if consent_note %} ({{ consent_note }}){% endif %}.
    </p>
    <p class="meta" style="margin:0 0 10px;font:400 12px/19px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.slate }}">
      {{ postal_address }}
    </p>
    <p class="meta" style="margin:0;font:400 12px/19px 'Liberation Sans',Arial,Helvetica,sans-serif;color:{{ palette.slate }}">
      <a href="{{ unsubscribe_url }}" style="color:{{ palette.slate }};text-decoration:underline">Unsubscribe</a>
      &nbsp;&middot;&nbsp;
      <a href="{{ preferences_url }}" style="color:{{ palette.slate }};text-decoration:underline">Email preferences</a>
      {% if web_url %}&nbsp;&middot;&nbsp;<a href="{{ web_url }}" style="color:{{ palette.slate }};text-decoration:underline">View in browser</a>{% endif %}
    </p>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
